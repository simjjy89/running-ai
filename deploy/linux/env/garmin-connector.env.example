# /etc/running-ai/garmin-connector.env  (owner root:runningai or runningai, mode 0600)
# NEVER put Garmin email, password, MFA codes or tokens here. Login is interactive (see
# deploy/linux/README.md); tokens live in /var/lib/running-ai/garmin-tokens (0700).

# The connector always binds to 127.0.0.1; only the port is configurable.
# It must match GARMIN_CONNECTOR_URL in running-ai.env.
GARMIN_CONNECTOR_PORT=8765
