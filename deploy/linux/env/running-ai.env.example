# /etc/running-ai/running-ai.env  (copy from this example; owner root:runningai or runningai, mode 0600)
# systemd EnvironmentFile syntax: KEY=value, no "export", no shell expansion.
# NEVER commit the real file. Real values below are intentionally empty.

# Spring profile (local = PostgreSQL via DB_*; the `test` profile is H2 and must not be used here)
SPRING_PROFILES_ACTIVE=local

# Bind to loopback only: Spring listens on all interfaces by default, and POST /api/v1/garmin/sync
# has no authentication. Do not change this to 0.0.0.0 without adding authentication first.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Database (native PostgreSQL on the same Pi shown; adjust for the Docker option)
DB_URL=jdbc:postgresql://127.0.0.1:5432/running_ai
DB_USERNAME=running_ai
DB_PASSWORD=

# Garmin connector (loopback, no Garmin credentials belong in this file)
GARMIN_CONNECTOR_URL=http://127.0.0.1:8765

# Automatic Garmin incremental sync (Spring scheduler; do not also schedule syncs with cron/timers)
RUNNING_AI_GARMIN_SCHEDULER_ENABLED=true
RUNNING_AI_GARMIN_SCHEDULER_FIXED_DELAY=1h
RUNNING_AI_GARMIN_SCHEDULER_INITIAL_DELAY=1m

# JVM options, e.g. a heap cap for a small Pi: JAVA_OPTS=-Xms128m -Xmx512m
JAVA_OPTS=
