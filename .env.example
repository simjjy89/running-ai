# Copy to .env (git-ignored) and fill in real values. Never commit real values.

# --- Database (local profile) ---
DB_URL=jdbc:postgresql://localhost:5432/runningai
DB_USERNAME=
DB_PASSWORD=

# --- Default athlete (optional; defaults: "default" / Asia/Seoul) ---
RUNNING_AI_ATHLETE_NAME=
RUNNING_AI_ATHLETE_TIMEZONE=

# --- Garmin (not used yet; reserved for the ingestion adapter) ---
GARMIN_USERNAME=
GARMIN_PASSWORD=

# --- Intervals.icu (not used yet; reserved for the integration adapter) ---
INTERVALS_API_KEY=
