# Copy to .env (git-ignored) and fill in real values. Never commit real values.
#
# Readers of this one file:
#   - docker compose                       -> POSTGRES_*            (container bootstrap)
#   - server, "local" profile              -> DB_*, SERVER_*, RUNNING_AI_*, GARMIN_*, INTERVALS_*,
#                                             WORKOUT_*, RUNNINGAI_MCP_*
#   - scripts\windows\*.ps1                -> SERVER_PORT, GARMIN_CONNECTOR_URL, the publishing and
#                                             MCP switches (operator status/safety checks)
#   - scripts\windows\external\*.ps1       -> RUNNING_AI_EXTERNAL_BASE_URL
#   - tools\external-relay\server.js       -> INTERVALS_ICU_API_KEY
# A real environment variable always wins over a value in this file.
#
# Every switch below is listed with its SOURCE DEFAULT. A line that is absent from .env behaves
# exactly like the default - the file never needs to be complete, only correct.

# =============================================================================================
# PostgreSQL container (docker-compose.yml)
# =============================================================================================
POSTGRES_DB=running_ai
POSTGRES_USER=running_ai
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# =============================================================================================
# Server datasource (local profile)
# =============================================================================================
DB_URL=jdbc:postgresql://localhost:5432/running_ai
DB_USERNAME=running_ai
DB_PASSWORD=

# =============================================================================================
# Server HTTP binding
# ---------------------------------------------------------------------------------------------
# SERVER_ADDRESS is a SECURITY CONTROL, not a convenience: the RunningAI REST API and /mcp have no
# authentication, so 127.0.0.1 is what keeps them off the LAN. Do not widen it. Anything that must
# be reachable from outside goes through a dedicated, authenticated front (tools\external-relay for
# the watch face, tools\mcp-gateway for MCP) behind a tunnel.
# SERVER_PORT is also read by scripts\windows\*.ps1 so the operator scripts and the watchdog probe
# the same port the server actually binds (Phase 6I-1.6C/6C-3).
# =============================================================================================
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# =============================================================================================
# Default athlete (optional; defaults: "default" / Asia/Seoul)
# =============================================================================================
RUNNING_AI_ATHLETE_NAME=
RUNNING_AI_ATHLETE_TIMEZONE=

# =============================================================================================
# Garmin
# ---------------------------------------------------------------------------------------------
# There is deliberately NO GARMIN_USERNAME / GARMIN_PASSWORD here. Spring never holds Garmin
# credentials: you log in once with
#     python -m garmin_connector login
# and the library stores its tokens outside this repository (default ~/.garminconnect). Never put
# Garmin credentials in this file - nothing reads them.
# =============================================================================================
# Localhost Python connector (tools/garmin-connector). Default http://127.0.0.1:8765
GARMIN_CONNECTOR_URL=

# Sample stream resolution asked of the connector for /samples only. Default 20000, range 1..100000
# (outside that range startup fails). Asking for more never makes a stream complete - completeness
# is read back out of the response and recorded per collection as FULL / DOWNSAMPLED / UNKNOWN.
GARMIN_DETAIL_SAMPLES_MAX_CHART_SIZE=

# Automatic incremental ACTIVITY sync (GarminSyncScheduler). Default false. Only the automatic
# trigger is gated; POST /api/v1/garmin/sync always works. Needs the local connector.
# NOTE: application.yml binds this one as a literal false rather than a ${...} placeholder; the
# environment variable still wins (the systemEnvironment property source outranks application.yml),
# but the spelling is not interchangeable with the RUNNINGAI_* style used by the MCP switches.
RUNNING_AI_GARMIN_SCHEDULER_ENABLED=false

# Automatic Garmin athlete intensity-profile sync (Phase 6D). Default false. Independent of the
# activity sync scheduler and of workout publishing; nothing downstream depends on it succeeding.
# From Phase 7B-4 on, every run also appends one row to athlete_intensity_profile_history
# (applied=false when Garmin reports the same values again).
GARMIN_PROFILE_SYNC_ENABLED=false
# GARMIN_PROFILE_SYNC_SCHEDULER_CRON=0 30 4 * * *
# GARMIN_PROFILE_SYNC_SCHEDULER_ZONE=Asia/Seoul

# Pause between two days of a recovery backfill (POST /api/v1/garmin/recovery-sync/backfill).
# Default 2s. A backfill is strictly sequential, never retries and stops at the first failure.
GARMIN_RECOVERY_BACKFILL_DELAY=

# =============================================================================================
# Intervals.icu
# ---------------------------------------------------------------------------------------------
# The API key comes from the environment only and is never committed. INTERVALS_API_KEY is used by
# the Spring workout publisher and the read-only enrichment client; INTERVALS_ICU_API_KEY is a
# SEPARATE variable read by tools\external-relay (the watch-face relay queries Intervals.icu
# server-side so the key never reaches the watch).
# =============================================================================================
INTERVALS_API_KEY=
# Optional; default 0 = the athlete that owns the key
INTERVALS_ATHLETE_ID=
INTERVALS_ICU_API_KEY=

# Import of activities that exist ONLY in Intervals.icu (Phase 7E-1,
# POST /api/v1/intervals/activity-import). Read-only towards Intervals.icu; it cannot publish.
# OFF by default: this is the only path in the repo that creates activity rows from a source other
# than Garmin. It also refuses to start while any publishing switch or Garmin scheduler is on.
# No scheduler, no startup run, no MCP tool - an explicit POST is the only trigger, and re-POSTing
# is both the resume and the retry.
RUNNING_AI_INTERVALS_ACTIVITY_IMPORT_ENABLED=false

# =============================================================================================
# Historical backfill (Phase 6H-6, POST /api/v1/historical-backfill)
# ---------------------------------------------------------------------------------------------
# Manual only, no scheduler, no auto-resume. Start/resume refuse unless all four publishing
# switches AND both Garmin schedulers are false.
# =============================================================================================
# Pause between two activities whose detail is actually fetched from Garmin. Default 2s.
HISTORICAL_BACKFILL_ACTIVITY_DELAY=

# =============================================================================================
# Workout publishing - LEGACY deterministic date-based path
# =============================================================================================
# Manual trigger (POST /api/v1/workout-publish). Default false.
# Keep false until the legacy main-PC workout publisher is disabled (two writers on one calendar).
WORKOUT_PUBLISHING_ENABLED=false

# Automatic daily trigger (WorkoutPublishingScheduler); calls only WorkoutPublishApplicationService
# and never bypasses the master switch above. Default false. Enable only after the legacy main-PC
# writer is disabled AND a manual POST smoke test passed. No retry, no catch-up of missed runs.
WORKOUT_PUBLISHING_SCHEDULER_ENABLED=false
# WORKOUT_PUBLISHING_SCHEDULER_CRON=0 0 5 * * *
# WORKOUT_PUBLISHING_SCHEDULER_ZONE=Asia/Seoul

# =============================================================================================
# Workout publishing - APPROVED AI-COACH DRAFT path (Phase 6G)
# ---------------------------------------------------------------------------------------------
# POST /api/v1/workout-drafts/{id}/publish. Default false; generating, revising, approving and
# previewing drafts all work while it is off. No scheduler, no MCP tool.
# Never true together with WORKOUT_PUBLISHING_ENABLED: the server refuses to start
# (PublishingModeGuard - legacy publishing XOR AI draft publishing).
# =============================================================================================
RUNNING_AI_DRAFT_PUBLISHING_ENABLED=false

# =============================================================================================
# MCP (POST /mcp)
# ---------------------------------------------------------------------------------------------
# Two INDEPENDENT switches. The Spring AI MCP server turns on when EITHER is true.
# /mcp itself has NO authentication and, on an unknown JSON-RPC method, the Spring AI transport
# answers HTTP 500 with a Java stack trace in the body. Never expose /mcp directly: put
# tools\mcp-gateway (OAuth 2.1 resource server, method + tool allowlist) in front of it.
# =============================================================================================
# WRITE adapter: registers the single tool publish_workout (Phase 6C). Default false.
# A publish additionally needs WORKOUT_PUBLISHING_ENABLED=true.
RUNNINGAI_MCP_ENABLED=false

# READ-ONLY tools (Phase 7C-2a): get_recent_activities, get_activity_analysis, get_training_context,
# get_recovery_context, get_fitness_trend, get_workout_recommendation, get_athlete_profile.
# Default false. With only this on, publish_workout is not registered at all. These tools expose
# personal training, recovery and analysis data - keep false until the authenticated gateway is in
# front of /mcp.
RUNNINGAI_MCP_READ_ENABLED=false

# =============================================================================================
# AI coach (Phase 6E / 6H-7)
# ---------------------------------------------------------------------------------------------
# Designs workout DRAFTS only; nothing in this path can publish to Intervals or write to Garmin.
# Holds no credential: the Claude provider uses the Claude Code CLI's own login session on this
# host (no ANTHROPIC_API_KEY is read, stored or forwarded anywhere - do not add one here).
# =============================================================================================
# Default CLAUDE
RUNNING_AI_COACH_PROVIDER=
# V1 or V2 (default V1). V2 is the DB-only context that carries Garmin detail, RunningAI analysis
# and Intervals CTL/ATL. Set it through THIS variable name - the Spring property path alone is not
# enough (Phase 6H-7 lesson: a missing ${...} placeholder made the env var silently do nothing).
RUNNING_AI_TRAINING_CONTEXT_VERSION=V1
# Claude CLI invocation (defaults: claude / sonnet / 120s)
RUNNING_AI_COACH_CLAUDE_COMMAND=
RUNNING_AI_COACH_CLAUDE_MODEL=
RUNNING_AI_COACH_CLAUDE_TIMEOUT=
# TrainingContext V2 size limits (defaults: 8 / 3 / 65536). The snapshot is rejected with
# TRAINING_CONTEXT_TOO_LARGE before any coach call rather than silently truncated.
RUNNING_AI_COACH_CONTEXT_V2_MAX_RECENT_ACTIVITIES=
RUNNING_AI_COACH_CONTEXT_V2_MAX_INTERVAL_GROUPS=
RUNNING_AI_COACH_CONTEXT_V2_MAX_SNAPSHOT_BYTES=

# Automatic periodic coach data refresh (CoachDataRefreshScheduler, Phase 6H-9). Default false.
# With it off, run POST /api/v1/coach/data-refresh before generating a draft or the coach reasons
# over whatever happened to be collected last.
RUNNING_AI_COACH_REFRESH_SCHEDULER_ENABLED=false

# =============================================================================================
# Injury / pain safety gate (Phase 7B-2)
# ---------------------------------------------------------------------------------------------
# How long a reported injury/pain status stays trusted. Default 48 hours. ACTIVE, RESOLVED and
# UNKNOWN all expire: an old all-clear does not keep certifying today's training. Past the window
# - and when no status has ever been reported - every workout-producing path is restricted to REST.
# =============================================================================================
RUNNING_AI_INJURY_SAFETY_STALENESS_HOURS=

# =============================================================================================
# External access (scripts\windows\external\*.ps1, tools\external-relay)
# ---------------------------------------------------------------------------------------------
# Public base URL of the tunnel in front of the relay, written and re-read by the external-access
# setup scripts. The relay itself binds 127.0.0.1 only and gates /today-workout with a Bearer token
# from tools\external-relay\secrets\watch-token.json (created by `node generate-token.js`, never
# committed and never placed in this file).
# =============================================================================================
RUNNING_AI_EXTERNAL_BASE_URL=

# =============================================================================================
# MCP OAuth gateway (tools\mcp-gateway, Phase 7C-2b) - not part of the Spring process
# ---------------------------------------------------------------------------------------------
# Set these in the gateway's own environment, not necessarily here. It is a resource server only:
# it verifies tokens an authorization server issued and never issues one. Missing required values
# make it refuse to start (fail closed), and publish_workout can never be allowlisted.
# =============================================================================================
# RUNNING_AI_OAUTH_ISSUER=https://<tenant>.auth0.com/
# RUNNING_AI_OAUTH_AUDIENCE=<the API identifier the token must be minted for>
# RUNNING_AI_ALLOWED_SUB=<the one permitted subject>
# RUNNING_AI_PUBLIC_BASE_URL=https://<public-host>
# RUNNING_AI_REQUIRED_SCOPE=runningai:read
# RUNNING_AI_GATEWAY_PORT=17910
# RUNNING_AI_GATEWAY_TARGET_URL=http://127.0.0.1:8080/mcp
# RUNNING_AI_ALLOWED_TOOLS=<comma list; defaults to the seven read-only tools>

# =============================================================================================
# Test-only escape hatches - never set these on an operating PC
# ---------------------------------------------------------------------------------------------
# Used by scripts\windows\tests\*.ps1 to redirect the .env root, the .runtime directory and the
# relay directory at isolated temporary paths so a test never touches real runtime state.
# =============================================================================================
# RUNNING_AI_TEST_ENV_ROOT=
# RUNNING_AI_TEST_RUNTIME_DIR=
# RUNNING_AI_TEST_RELAY_DIR=
# WATCHFACE_RELAY_MOCK=
