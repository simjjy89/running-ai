# Copy to .env (git-ignored) and fill in real values. Never commit real values.
#
# The same file serves two readers:
#   - docker compose        -> POSTGRES_* (container bootstrap)
#   - server (local profile) -> DB_* (imported as a fallback; real env vars win)

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_DB=running_ai
POSTGRES_USER=running_ai
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Server datasource (local profile) ---
DB_URL=jdbc:postgresql://localhost:5432/running_ai
DB_USERNAME=running_ai
DB_PASSWORD=

# --- Default athlete (optional; defaults: "default" / Asia/Seoul) ---
RUNNING_AI_ATHLETE_NAME=
RUNNING_AI_ATHLETE_TIMEZONE=

# --- Garmin (not used yet; reserved for the ingestion adapter) ---
GARMIN_USERNAME=
GARMIN_PASSWORD=

# --- Intervals.icu workout publisher (API key only from the environment; never commit a real value) ---
# INTERVALS_ATHLETE_ID is optional (default 0 = the athlete that owns the key)
INTERVALS_API_KEY=

# --- Manual workout publish trigger (POST /api/v1/workout-publish) ---
# Keep false until the legacy main-PC workout publisher is disabled (two writers on one calendar). Default false.
WORKOUT_PUBLISHING_ENABLED=false

# --- Automatic daily workout publishing (WorkoutPublishingScheduler) ---
# Separate from the master switch above (it never bypasses it). Keep false until the legacy main-PC writer is disabled
# AND a manual POST smoke test passed. Default false; cron 0 0 5 * * * in Asia/Seoul when enabled.
WORKOUT_PUBLISHING_SCHEDULER_ENABLED=false
# WORKOUT_PUBLISHING_SCHEDULER_CRON=0 0 5 * * *
# WORKOUT_PUBLISHING_SCHEDULER_ZONE=Asia/Seoul

# --- Publishing APPROVED AI-coach drafts (POST /api/v1/workout-drafts/{id}/publish, Phase 6G) ---
# Independent of WORKOUT_PUBLISHING_ENABLED (legacy date-based path). Default false; approve and preview work while off.
# Keep false while the legacy main-PC workout writer is active. No scheduler, no MCP tool.
RUNNING_AI_DRAFT_PUBLISHING_ENABLED=false

# --- MCP adapter (POST /mcp, tool publish_workout) ---
# Also switches the Spring AI MCP server. Default false. A publish additionally needs WORKOUT_PUBLISHING_ENABLED=true.
# No authentication on /mcp: never expose it to the public Internet.
RUNNINGAI_MCP_ENABLED=false
